{{ 'template-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'template-accordion.js' | asset_url }}" defer></script>
<div
  class="info-grid__accordion{% if block.settings.open_by_default %} is-open {% endif %}"
  style="--accordion-bg: {{ block.settings.background_color }};"
  {{ block.shopify_attributes }}
>
  <button class="accordion__header">
    <span>
      {% if block.settings.icon != blank %}
        {{ block.settings.icon | image_url: width: 24 | image_tag }}
      {% else %}
        <img
          src="{{ 'template-placeholder-icon.svg' | asset_url }}"
          alt="USP icon"
          width="24"
          height="24"
          class="usp__icon-image"
        >
      {% endif %}

      {{ block.settings.heading }}
    </span>

    <span class="accordion__icon">
      {% render 'template-up-arrow' %}
    </span>
  </button>

  <div class="accordion__content">
    {{ block.settings.content }}
  </div>
</div>

<div
  style="--accordion-bg: {{ block.settings.background_color }};"
  class="info-grid__mobile-block"
  {{ block.shopify_attributes }}
>
  <div class="info-grid__mobile-heading">
    {% if block.settings.icon != blank %}
      {{ block.settings.icon | image_url: width: 24 | image_tag }}
    {% else %}
      <img
        src="{{ 'template-placeholder-icon.svg' | asset_url }}"
        alt="USP icon"
        width="24"
        height="24"
        class="usp__icon-image"
      >
    {% endif %}

    {{ block.settings.heading }}
  </div>

  <div class="info-grid__mobile-content">
    {{ block.settings.content }}
  </div>
</div>
