<div class="share-card">
  <h3 class="share-card__heading">Share This Article</h3>

  <div class="share-card__socials">
    <a href="#" class="share-card__link" aria-label="Facebook">
      <img
        src="{{ 'icon-facebook.svg' | asset_url }}"
        alt="Star"
        width="16"
        height="16"
      >
    </a>

    <a href="#" class="share-card__link" aria-label="X">
      <img
        src="{{ 'icon-twitter.svg' | asset_url }}"
        alt="Star"
        width="16"
        height="16"
      >
    </a>

    <a href="#" class="share-card__link" aria-label="Copy Link">
      <img
        src="{{ 'icon-linkedIn.svg' | asset_url }}"
        alt="Star"
        width="16"
        height="16"
      >
    </a>
  </div>
</div>
