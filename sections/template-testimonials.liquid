{{ 'template-testimonials.css' | asset_url | stylesheet_tag }}
<section
  class="testimonials"
  style="
    --testimonials-background: {{ section.settings.background_color }};
    --testimonials-padding-top: {{ section.settings.padding_top }}px;
    --testimonials-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width-custom">
    <!-- Header -->
    <div class="testimonials__header">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tag' %}
            <span class="testimonials__tag" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </span>
          {% when 'heading' %}
            <h2 class="testimonials__heading" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>
        {% endcase %}
      {% endfor %}

      <div class="testimonials__rating">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'rating' %}
              <div class="testimonials__stars" {{ block.shopify_attributes }}>
                {% for i in (1..block.settings.stars) %}
                  <img
                    src="{{ 'template-star.svg' | asset_url }}"
                    alt="Star"
                    width="16"
                    height="16"
                  >
                {% endfor %}
              </div>

              <span class="testimonials__rating-text">
                {{ block.settings.text }}
              </span>
          {% endcase %}
        {% endfor %}
      </div>
    </div>

    <!-- Testimonials -->
    <!-- Desktop -->
    <div class="testimonials__grid testimonials__grid--desktop">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'review' %}
            <div class="testimonial-card" {{ block.shopify_attributes }}>
              <div class="testimonial-card__stars">
                {% for i in (1..block.settings.stars) %}
                  <img
                    src="{{ 'template-star.svg' | asset_url }}"
                    alt="Star"
                    width="16"
                    height="16"
                  >
                {% endfor %}
              </div>

              <div class="testimonial-card__review">
                {{ block.settings.review }}
              </div>

              <div class="testimonial-card__author">
                <div class="testimonial-card__image">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 80
                      | image_tag: class: 'testimonial-card__image-img', alt: block.settings.name
                    }}
                  {% else %}
                    <img
                      src="{{ 'icon-silhouette.svg' | asset_url }}"
                      alt="Star"
                      width="16"
                      height="16"
                    >
                  {% endif %}
                </div>

                <span class="testimonial-card__name">
                  {{ block.settings.name }}
                </span>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Mobile -->
    <div class=" swiper testimonials__slider--mobile">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'review' %}
              <div class="testimonial-card swiper-slide" {{ block.shopify_attributes }}>
                <div class="testimonial-card__stars">
                  {% for i in (1..block.settings.stars) %}
                    <img
                      src="{{ 'template-star.svg' | asset_url }}"
                      alt="Star"
                      width="16"
                      height="16"
                    >
                  {% endfor %}
                </div>

                <div class="testimonial-card__review">
                  {{ block.settings.review }}
                </div>

                <div class="testimonial-card__author">
                  <div class="testimonial-card__image">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 80
                        | image_tag: class: 'testimonial-card__image-img', alt: block.settings.name
                      }}
                    {% else %}
                      <img
                        src="{{ 'icon-silhouette.svg' | asset_url }}"
                        alt="{{ block.settings.name }}"
                        width="80"
                        height="80"
                      >
                    {% endif %}
                  </div>

                  <span class="testimonial-card__name">
                    {{ block.settings.name }}
                  </span>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    console.log('Swiper init');
    new Swiper('.testimonials__slider--mobile', {
      slidesPerView: 1,
      spaceBetween: 20,
      pagination: {
        el: '.testimonials__slider--mobile .swiper-pagination',
        clickable: true,
      },
    });
  });
</script>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tag",
          "default": "#WINTOMORROW WITH PARTY PATCH"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Trusted by Millions"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "text",
          "label": "Rating Text",
          "default": "4.8 stars from 500,000+ reviews"
        }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Image"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name"
        },
        {
          "type": "richtext",
          "id": "review",
          "label": "Review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "tag",
          "settings": {
            "text": "#WINTOMORROW WITH PARTY PATCH"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Trusted by Millions"
          }
        },
        {
          "type": "rating",
          "settings": {
            "stars": 5,
            "text": "4.8 stars from 500,000+ reviews"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Jennifer",
            "review": "<p>“I didn’t know how these patches work, but they are amazing. I used to get hungover every time I drank, even when I only had a drink or two. I’ll never drink without a patch again, with every penny.”</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Michael",
            "review": "<p>“Husband and i both in our 40s, tried these for a big party event. Woke up feeling great, these patches are very effectiv”</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Sarah",
            "review": "<p>“This product really works. Drank a fifth of tequila the night  before (that’s a lot of alcohol for me) and no hangover or symptoms whatever. Good and bad. lmao. But it works!”</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
