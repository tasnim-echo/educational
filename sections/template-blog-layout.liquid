{{ 'template-blog-layout.css' | asset_url | stylesheet_tag }}

<section
  class="blog-layout"
  style="
    --blog-layout-padding-top: {{ section.settings.padding_top }}px;
    --blog-layout-padding-bottom: {{ section.settings.padding_bottom }}px;
    --blog-layout-padding-inline: {{ section.settings.padding_inline }}px;
  "
>
  <div class="blog-layout__mobile-jump">
    {% render 'template-jump-to-card' %}
  </div>
  <div class="page-width-custom">
    <div class="blog-layout__wrapper">
      <div class="blog-layout__content">
        {% comment %} first snippet:hangover_cause {% endcomment %}
        {% assign hangover_cause = article.metafields.custom.hangover_cause.value %}
        {% render 'template-blog-hangover-cause', section_data: hangover_cause %}

        {% comment %} first snippet:hangover-science {% endcomment %}
        {% assign science = article.metafields.custom.hangover_patches_science.value %}
        {% render 'template-blog-hangover-science', section_data: science %}

        {% comment %} first snippet:how_to_use {% endcomment %}
        {% assign how_to_use = article.metafields.custom.how_to_use.value %}
        {% render 'template-blog-how-to-use', section_data: how_to_use %}

        {% comment %} first snippet:how_to_use {% endcomment %}
        {% assign cta = article.metafields.custom.try_partypatch.value -%}
        {%- render 'template-blog-try-party-patch', section_data: cta %}

        {% comment %} first snippet:how_to_use {% endcomment %}
        {% assign testimonials = article.metafields.custom.blog_testimonials.value %}
        {% render 'template-blog-testimonials', section_data: testimonials %}

        {% comment %} first snippet:perfect_for{% endcomment %}
        {% assign perfect_for = article.metafields.custom.perfect_for.value %}
        {% render 'template-blog-perfect-usage', section_data: perfect_for %}

        {% comment %} first snippet:comparison_table{% endcomment %}
        {% assign comparison = article.metafields.custom.comparison_table.value %}
        {% render 'template-blog-comparison-table', section_data: comparison %}

        {% comment %} first snippet:comparison_table{% endcomment %}
        {% assign faq = article.metafields.custom.faq.value %}
        {% render 'template-blog-faq', section_data: faq %}

        <div class="blog-layout__mobile-share">
          {% render 'template-share-card' %}
        </div>

        {% comment %} first snippet:written_by{% endcomment %}
        {% assign written_by = article.metafields.custom.written_by.value %}
        {% render 'template-blog-written-by', section_data: written_by %}
      </div>

      {% render 'template-blog-sidebar' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Layout",

  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Padding Inline",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],

  "presets": [
    {
      "name": "Blog Layout"
    }
  ]
}
{% endschema %}
