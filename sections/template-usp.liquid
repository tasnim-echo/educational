{{ 'template-usp.css' | asset_url | stylesheet_tag }}

<section
  class="usp"
  style="
    --usp-background: {{ section.settings.background_color }};
    --usp-padding-top: {{ section.settings.padding_top }}px;
    --usp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --usp-padding-inline: {{ section.settings.padding_inline}}px;
  "
>
  <div class="usp__container">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'usp' %}
          <div class="usp__item" {{ block.shopify_attributes }}>
            <div class="usp__icon">
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | image_url: width: 48 | image_tag }}
              {% endif %}
            </div>

            <div class="usp__content">
              <span class="usp__title">
                {{ block.settings.heading }}
              </span>

              <span class="usp__subtitle">
                {{ block.settings.subheading }}
              </span>
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "USP Section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#86E4ED"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Padding Inline",
      "min": 150,
      "max": 250,
      "step": 4,
      "unit": "px",
      "default": 150
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "5 Free Patches"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "On orders $40+"
        }
      ]
    }
  ]
}
{% endschema %}
