{{ 'template-information-grid.css' | asset_url | stylesheet_tag }}

<section
  class="info-grid"
  style="
    --info-grid-bg: {{ section.settings.background_color }};
    --info-grid-padding-top: {{ section.settings.padding_top }}px;
    --info-grid-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <!-- Header -->
    <div class="info-grid__header">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tag' %}
            <p class="info-grid__tag" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>
          {% when 'heading' %}
            <h2 class="info-grid__heading" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>

          {% when 'subheading' %}
            <div class="info-grid__subheading" {{ block.shopify_attributes }}>
              {{ block.settings.subheading }}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Feature Grid -->
    <div class="info-grid__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'feature' %}
            <div class="feature-card" {{ block.shopify_attributes }}>
              <div class="feature-card__icon">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 28 | image_tag }}

                {% else %}
                  <img
                    src="{{ 'template-placeholder-icon.svg' | asset_url }}"
                    alt="USP icon"
                    width="48"
                    height="48"
                    class="usp__icon-image"
                  >
                {% endif %}
              </div>

              <div class="feature-card__content">
                <h3 class="feature-card__title">
                  {{ block.settings.title }}
                </h3>

                <p class="feature-card__description">
                  {{ block.settings.description }}
                </p>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Footer -->
    <div class="info-grid__footer">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'button' %}
            <div class="info-grid__button-wrapper">
              <a
                href="{{ block.settings.link }}"
                class="info-grid__button"
                style="--button-bg: {{ block.settings.background_color }};"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </a>
            </div>

          {% when 'accordion' %}
            {% render 'template-accordion', block: block %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Information Grid",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tag"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p>Alcohol depletes your body of essential vitamins and nutrients, disrupts your sleep cycle, and causes dehydration.</p>"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pounding headaches"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button Label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#86E4ED"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#fef7e0"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Information Grid",
      "blocks": [
        {
          "type": "tag",
          "settings": {
            "text": "THE PROBLEM"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Why Do Hangovers Feel So Bad?"
          }
        },
        {
          "type": "subheading",
          "settings": {
            "subheading": "<p>Alcohol depletes your body of essential vitamins and nutrients, disrupts your sleep cycle, and causes dehydration — a perfect storm that leaves you wrecked the next morning.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Pounding headaches",
            "description": "Alcohol causes blood vessels to expand and triggers inflammation, leaving your head throbbing."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Nausea & stomach pain",
            "description": "Alcohol irritates your stomach lining and disrupts your digestive system, causing waves of nausea."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Extreme fatigue",
            "description": "Despite sleeping, alcohol fragments your sleep cycles so you wake up feeling more tired than before."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Brain fog & irritability",
            "description": "Alcohol depletes B vitamins essential for brain function, leaving you foggy, anxious, and on edge."
          }
        },
        {
          "type": "accordion",
          "settings": {
            "heading": "Did you know?",
            "content": "<p>When you swallow a vitamin pill the morning after, only ~10% of the nutrients actually reach your bloodstream. The rest is destroyed by your already-irritated stomach acid.</p>",
            "open_by_default": true,
            "background_color": "#fef7e0"
          }
        }
      ]
    }
  ]
}
{% endschema %}
