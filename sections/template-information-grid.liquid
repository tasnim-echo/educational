{{ 'template-information-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'template-accordion.js' | asset_url }}" defer></script>

<section
  class="info-grid"
  style="
    --info-grid-bg: {{ section.settings.background_color }};
    --info-grid-padding-top: {{ section.settings.padding_top }}px;
    --info-grid-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <!-- Header -->
    <div class="info-grid__header">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tag' %}
            <p class="info-grid__tag" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>
          {% when 'heading' %}
            <h2 class="info-grid__heading" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>

          {% when 'subheading' %}
            <div class="info-grid__subheading" {{ block.shopify_attributes }}>
              {{ block.settings.subheading }}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Feature Grid -->
    <div class="info-grid__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'feature' %}
            <div class="feature-card" {{ block.shopify_attributes }}>
              <div class="feature-card__icon">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 28 | image_tag }}
                {% endif %}
              </div>

              <div class="feature-card__content">
                <h3 class="feature-card__title">
                  {{ block.settings.title }}
                </h3>

                <p class="feature-card__description">
                  {{ block.settings.description }}
                </p>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Footer -->
    <div class="info-grid__footer">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'button' %}
            <a
              href="{{ block.settings.link }}"
              class="info-grid__button"
              style="--button-bg: {{ block.settings.background_color }};"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>

          {% when 'accordion' %}
            <div
              class="info-grid__accordion{% if block.settings.open_by_default %} is-open {% endif %}"
              style="--accordion-bg: {{ block.settings.background_color }};"
              {{ block.shopify_attributes }}
            >
              <button class="accordion__header">
                <span>
                  {% if block.settings.icon != blank %}
                    {{ block.settings.icon | image_url: width: 24 | image_tag }}
                  {% endif %}

                  {{ block.settings.heading }}
                </span>

                <span class="accordion__icon">
                  {% render 'template-up-arrow' %}
                </span>
              </button>

              <div class="accordion__content">
                {{ block.settings.content }}
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Information Grid",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tag",
          "default": "THE PROBLEM"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Why Do Hangovers Feel So Bad?"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p>Alcohol depletes your body of essential vitamins and nutrients, disrupts your sleep cycle, and causes dehydration.</p>"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pounding headaches"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Alcohol causes blood vessels to expand and triggers inflammation, leaving your head throbbing."
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button Label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#86E4ED"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Did you know?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>When you swallow a vitamin pill the morning after, only ~10% of the nutrients actually reach your bloodstream. The rest is destroyed by your already-irritated stomach acid — which is exactly why pills feel useless when you're hungover.</p>"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#fef7e0"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
