{{ 'template-hero.css' | asset_url | stylesheet_tag }}

{% if template.name == 'article' %}
  {% assign hero_details = article.metafields.custom.hero_details.value %}
{% endif %}

<section
  class="hero"
  style="
    --hero-background: {{ section.settings.background_color }};
    --hero-padding-top: {{ section.settings.padding_top }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hero-padding-inline: {{ section.settings.padding_inline }}px;
  "
>
  <div class="hero__container">
    <div class="hero__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tag' %}
            <span class="hero__tag" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </span>

          {% when 'breadcrumb' %}
            {% if template.name == 'article' %}
              {% assign breadcrumb_title = article.title | split: ':' | first %}

              <nav class="hero__breadcrumb">
                <a href="{{ routes.root_url }}">Home</a>
                <span>></span>
                <a href="{{ blog.url }}">Blog</a>
                <span>></span>
                <span>{{ breadcrumb_title }}</span>
              </nav>
            {% endif %}

          {% when 'heading' %}
            <h1 class="hero__title" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h1>

          {% when 'subheading' %}
            <div class="hero__subtitle" {{ block.shopify_attributes }}>
              {{ block.settings.subheading }}
            </div>

          {% when 'feature' %}
            <div class="hero__feature" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | image_url: width: 40 | image_tag: class: 'hero__icon-image' }}
              {% else %}
                <div class="hero__icon">
                  <svg width="800px" height="800px" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 7.5L7 10L11 5M7.5 14.5C3.63401 14.5 0.5 11.366 0.5 7.5C0.5 3.63401 3.63401 0.5 7.5 0.5C11.366 0.5 14.5 3.63401 14.5 7.5C14.5 11.366 11.366 14.5 7.5 14.5Z" stroke="#000000"/>
                  </svg>
                </div>
              {% endif %}

              <span>{{ block.settings.text }}</span>
            </div>

          {% when 'button' %}
            <a
              href="{{ block.settings.link }}"
              class="hero__button"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>

          {% when 'article_meta' %}
            {% if template.name == 'article' and hero_details %}
              <div class="hero__article-meta" {{ block.shopify_attributes }}>
                {% if hero_details.author_image %}
                  {{ hero_details.author_image | image_url: width: 80 | image_tag: class: 'hero__article-avatar' }}
                {% endif %}

                <div class="hero__article-meta-content">
                  <p class="hero__article-author">
                    {{ hero_details.author_name }}
                  </p>

                  <p class="hero__article-info">
                    {{ article.published_at | date: '%B %-d, %Y' }}
                    ·
                    {{ hero_details.reading_time }} min read
                  </p>
                </div>
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>

    <div class="hero__image">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: alt: section.settings.image_alt, class: 'hero__image-img'
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image-placeholder' }}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Padding Inline",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tag",
          "default": "Science-Backed Hangover Relief"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Your Personal Bodyguard… But For Hangovers"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p>Hangover patches that deliver vitamins and nutrients while you sleep. Science-backed relief that actually works.</p>"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Premium Quality Materials"
        }
      ]
    },

    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button Label",
          "default": "Shop Patches Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    },
    {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "limit": 1,
      "settings": []
    },
    {
      "type": "article_meta",
      "name": "Article Meta",
      "limit": 1,
      "settings": []
    }
  ],

  "presets": [
    {
      "name": "Hero Section",
      "blocks": [
        {
          "type": "tag",
          "settings": {
            "text": "Science-Backed Hangover Relief"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Your Personal Bodyguard… But For Hangovers"
          }
        },
        {
          "type": "subheading",
          "settings": {
            "subheading": "<p>Hangover patches that deliver vitamins and nutrients while you sleep. Science-backed relief that actually works.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Premium Quality Materials"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Scientifically Formulated"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Works While You Sleep"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Fast & Easy to Apply"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Loved by Thousands"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Shop Patches Now"
          }
        },
        {
          "type": "article_meta",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
